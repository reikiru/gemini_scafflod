#!/usr/bin/env python3
"""Gemini 手脚架：沙盒内通用文件桥客户端。

只做文件读写：写请求到 var/queue，等 var/done 里的回复。
不建立任何网络连接，因此不会触发 Gemini 的网络访问批准。

用法见项目根目录的 用法.md。
"""

import json
import os
import sys
import time
import uuid
from datetime import datetime
from pathlib import Path

ROOT = Path(os.environ.get("GX_ROOT") or Path(__file__).resolve().parent.parent)
VAR = ROOT / "var"
QUEUE = VAR / "queue"
DONE = VAR / "done"
JOBS = VAR / "jobs"
LOGFILE = VAR / "log" / "bridge.log"
ALLOWLIST = ROOT / "bridge" / "allowlist.conf"

DEFAULT_TIMEOUT = float(os.environ.get("GX_TIMEOUT", "120"))
WAIT_SLACK = 15.0

HELP_TEXT = """gx — Gemini 沙盒外通用命令桥客户端

用法:
  gx [选项] [--] <命令> [参数...]
  gx bg [--json] [-e K=V] [--] <命令> ...  后台启动长任务，立即返回 job_id
  gx jobs [--json]                         查看后台任务列表与状态
  gx tail <job_id> [-n 行数]               查看后台任务输出日志（默认 40 行）
  gx kill <job_id>                         终止指定后台任务（按进程组）
  gx ping [--json]                         端到端探活，返回宿主机 pid、HOME、PATH
  gx status                                查看本地 pid 文件、队列深度与白名单路径
  gx log [-n 行数]                         查看审计日志（默认最近 40 行）

选项:
  -t, --timeout <秒>         单次同步命令超时时间（默认 120，或环境变量 GX_TIMEOUT）
  -o, --stdout-file <路径>   将命令的原始 stdout 二进制写入指定文件
  -e, --env <KEY=VAL>        向目标命令透传安全环境变量（可重复）
  -h, --help                 显示此帮助
"""


def parse_args(argv):
    """解析 gx 自身选项，返回 (real_argv, timeout, stdout_file, env_map)。"""
    timeout = DEFAULT_TIMEOUT
    stdout_file = None
    env_map = {}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            i += 1
            break
        if arg in ("-t", "--timeout"):
            if i + 1 >= len(argv):
                raise SystemExit("缺少 --timeout 参数值")
            timeout = float(argv[i + 1])
            i += 2
            continue
        if arg in ("-o", "--stdout-file"):
            if i + 1 >= len(argv):
                raise SystemExit("缺少 --stdout-file 参数值")
            stdout_file = os.path.abspath(os.path.expanduser(argv[i + 1]))
            i += 2
            continue
        if arg in ("-e", "--env"):
            if i + 1 >= len(argv):
                raise SystemExit("缺少 --env 参数值")
            pair = argv[i + 1]
            if "=" not in pair:
                raise SystemExit("--env 格式必须为 KEY=VAL: %s" % pair)
            k, v = pair.split("=", 1)
            if not k:
                raise SystemExit("--env 缺少变量名: %s" % pair)
            env_map[k] = v
            i += 2
            continue
        break
    return argv[i:], timeout, stdout_file, env_map


def submit_req(req, wait_timeout):
    QUEUE.mkdir(parents=True, exist_ok=True)
    DONE.mkdir(parents=True, exist_ok=True)
    req_id = "%s-%s" % (datetime.now().strftime("%Y%m%dT%H%M%S"), uuid.uuid4().hex[:6])
    req["id"] = req_id

    path = QUEUE / (req_id + ".json")
    tmp = QUEUE / (req_id + ".tmp")
    with tmp.open("w", encoding="utf-8") as f:
        json.dump(req, f, ensure_ascii=False)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)

    resp_path = DONE / (req_id + ".json")
    deadline = time.time() + wait_timeout
    while time.time() < deadline:
        if resp_path.exists():
            for _ in range(20):
                try:
                    return json.loads(resp_path.read_text(encoding="utf-8"))
                except ValueError:
                    time.sleep(0.05)
            return {"exit": 98, "error": "回复文件损坏"}
        time.sleep(0.05)

    return {
        "exit": 97,
        "error": "超时：%d 秒内没有回复。桥可能没启动，跑 gx status 看看。" % int(wait_timeout),
    }


def print_denied(resp):
    err_msg = resp.get("error", "")
    if "环境变量" in err_msg:
        print("被安全策略拒绝：%s" % err_msg, file=sys.stderr)
    else:
        print("被白名单拒绝：%s" % err_msg, file=sys.stderr)
        print("要放行就编辑 %s" % ALLOWLIST, file=sys.stderr)
    return 126


def submit(argv, timeout, stdout_file, env_map=None):
    req = {
        "action": "exec",
        "argv": argv,
        "cwd": os.getcwd(),
        "timeout": timeout,
    }
    if stdout_file:
        req["stdout_file"] = stdout_file
    if env_map:
        req["env"] = env_map
    if not sys.stdin.isatty():
        stdin_text = sys.stdin.read()
        if stdin_text:
            req["stdin"] = stdin_text
    return submit_req(req, timeout + WAIT_SLACK)


def cmd_ping(argv):
    as_json = "--json" in argv
    resp = submit_req({"action": "ping"}, wait_timeout=10.0)
    if resp.get("exit") != 0 or not resp.get("ok"):
        print(resp.get("error") or "ping 失败", file=sys.stderr)
        return resp.get("exit") or 1
    if as_json:
        print(json.dumps({
            "ok": True,
            "pid": resp.get("pid"),
            "uptime_sec": resp.get("uptime_sec"),
            "home": resp.get("home"),
            "path": resp.get("path"),
            "rules_count": resp.get("rules_count"),
            "active_jobs": resp.get("active_jobs", 0),
        }, ensure_ascii=False))
    else:
        print("pong pid=%s uptime=%ss rules=%s active_jobs=%s" % (
            resp.get("pid"), resp.get("uptime_sec"),
            resp.get("rules_count"), resp.get("active_jobs", 0)))
        print("home: %s" % resp.get("home"))
        print("path: %s" % resp.get("path"))
    return 0


def cmd_bg(argv):
    as_json = False
    env_map = {}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--":
            i += 1
            break
        if arg == "--json":
            as_json = True
            i += 1
            continue
        if arg in ("-e", "--env"):
            if i + 1 >= len(argv):
                print("缺少 --env 参数值", file=sys.stderr)
                return 2
            pair = argv[i + 1]
            if "=" not in pair or not pair.split("=", 1)[0]:
                print("--env 格式必须为 KEY=VAL: %s" % pair, file=sys.stderr)
                return 2
            k, v = pair.split("=", 1)
            env_map[k] = v
            i += 2
            continue
        break

    real_argv = argv[i:]
    if not real_argv:
        print("用法: gx bg [--json] [-e K=V] [--] <命令> [参数...]", file=sys.stderr)
        return 2

    req = {"action": "bg", "argv": real_argv, "cwd": os.getcwd()}
    if env_map:
        req["env"] = env_map
    resp = submit_req(req, wait_timeout=15.0)
    if resp.get("denied"):
        return print_denied(resp)
    if resp.get("exit") != 0:
        print(resp.get("error") or "后台启动失败", file=sys.stderr)
        return resp.get("exit") or 1

    if as_json:
        print(json.dumps({
            "job_id": resp.get("job_id"),
            "pid": resp.get("pid"),
            "log_file": resp.get("log_file"),
        }, ensure_ascii=False))
    else:
        print("job_id=%s pid=%s" % (resp.get("job_id"), resp.get("pid")))
        print("log: %s" % resp.get("log_file"))
    return 0


def cmd_jobs(argv):
    as_json = "--json" in argv
    resp = submit_req({"action": "jobs"}, wait_timeout=10.0)
    if resp.get("exit") != 0:
        print(resp.get("error") or "查询后台任务失败", file=sys.stderr)
        return resp.get("exit") or 1
    jobs = resp.get("jobs") or []
    if as_json:
        print(json.dumps(jobs, ensure_ascii=False))
        return 0
    if not jobs:
        print("暂无后台任务")
        return 0
    for j in jobs:
        cmd_str = " ".join(j.get("argv") or [])
        print("%s\t%-7s\tpid=%s\texit=%s\t%ss\t%s" % (
            j.get("job_id"), j.get("status"), j.get("pid"),
            j.get("exit"), j.get("elapsed_sec"), cmd_str))
    return 0


def cmd_tail(argv):
    if not argv:
        print("用法: gx tail <job_id> [-n 行数]", file=sys.stderr)
        return 2
    job_id = argv[0]
    if "/" in job_id or ".." in job_id:
        print("非法 job_id", file=sys.stderr)
        return 2
    lines = 40
    if len(argv) >= 3 and argv[1] == "-n":
        lines = int(argv[2])
    log_path = JOBS / (job_id + ".log")
    if not log_path.exists():
        print("找不到任务日志: %s" % log_path, file=sys.stderr)
        return 1
    content = log_path.read_text(encoding="utf-8", errors="replace").splitlines()
    for line in content[-lines:]:
        print(line)
    return 0


def cmd_kill(argv):
    if not argv:
        print("用法: gx kill <job_id>", file=sys.stderr)
        return 2
    resp = submit_req({"action": "kill_job", "job_id": argv[0]}, wait_timeout=15.0)
    if resp.get("exit") != 0:
        print(resp.get("error") or "终止失败", file=sys.stderr)
        return resp.get("exit") or 1
    print("job_id=%s status=%s" % (resp.get("job_id"), resp.get("status")))
    return 0


def local_status():
    pidfile = VAR / "bridge.pid"
    print("项目: %s" % ROOT)
    if pidfile.exists():
        pid = pidfile.read_text().strip()
        alive = False
        try:
            os.kill(int(pid), 0)
            alive = True
        except PermissionError:
            alive = True
        except Exception:
            alive = False
        print("守护进程: pid=%s %s" % (pid, "在跑" if alive else "已退出（pid 文件残留）"))
    else:
        print("守护进程: 没在跑")
    q = len(list(QUEUE.glob("*.json"))) if QUEUE.is_dir() else 0
    print("待处理: %d" % q)
    print("白名单: %s %s" % (ALLOWLIST, "存在" if ALLOWLIST.exists() else "缺失（可从 allowlist.conf.example 复制）"))
    return 0


def local_log(argv):
    lines = 40
    if len(argv) >= 2 and argv[0] == "-n":
        lines = int(argv[1])
    if not LOGFILE.exists():
        print("还没有日志")
        return 0
    for line in LOGFILE.read_text(encoding="utf-8", errors="replace").splitlines()[-lines:]:
        print(line)
    return 0


def main():
    argv = sys.argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(HELP_TEXT)
        return 0
    if argv[0] == "ping":
        return cmd_ping(argv[1:])
    if argv[0] == "bg":
        return cmd_bg(argv[1:])
    if argv[0] == "jobs":
        return cmd_jobs(argv[1:])
    if argv[0] == "tail":
        return cmd_tail(argv[1:])
    if argv[0] == "kill":
        return cmd_kill(argv[1:])
    if argv[0] == "status":
        return local_status()
    if argv[0] == "log":
        return local_log(argv[1:])

    try:
        real_argv, timeout, stdout_file, env_map = parse_args(argv)
    except (SystemExit, ValueError) as e:
        print(e, file=sys.stderr)
        return 2

    if not real_argv:
        print(HELP_TEXT)
        return 0

    resp = submit(real_argv, timeout, stdout_file, env_map)

    if resp.get("denied"):
        return print_denied(resp)
    if resp.get("error") and resp.get("exit") in (97, 98, 99, 127):
        print(resp["error"], file=sys.stderr)
        return resp.get("exit") or 1

    if stdout_file and resp.get("stdout_file"):
        print(resp["stdout_file"])
        print("(%s 字节)" % resp.get("bytes", "?"), file=sys.stderr)
    else:
        sys.stdout.write(resp.get("stdout") or "")

    err = resp.get("stderr")
    if err:
        sys.stderr.write(err)
    if resp.get("error"):
        sys.stderr.write("\n%s\n" % resp["error"])
    if resp.get("timed_out"):
        sys.stderr.write("\n命令超时，已被杀\n")
        return 124
    return resp.get("exit") or 0


if __name__ == "__main__":
    sys.exit(main())
